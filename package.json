{
  "name": "pi-workbench",
  "version": "1.4.5",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/copy-assets.mjs && cross-env PI_DESKTOP_DEV=1 electron-vite dev",
    "build": "electron-vite build && node scripts/copy-assets.mjs",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "dist": "pnpm build && electron-builder --config.nsis.oneClick=false --publish never",
    "dist:win": "pnpm build && electron-builder --win --config.nsis.oneClick=false --publish never"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tanstack/react-virtual": "^3.14.10",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-image": "^3.30.3",
    "@tiptap/extension-link": "^3.30.3",
    "@tiptap/extension-placeholder": "^3.30.3",
    "@tiptap/extension-table": "^3.30.3",
    "@tiptap/extension-task-item": "^3.30.3",
    "@tiptap/extension-task-list": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-clipboard": "0.3.0-beta.292",
    "@xterm/addon-fit": "0.12.0-beta.292",
    "@xterm/addon-search": "0.17.0-beta.292",
    "@xterm/addon-serialize": "0.15.0-beta.292",
    "@xterm/addon-unicode11": "0.10.0-beta.292",
    "@xterm/addon-web-links": "0.13.0-beta.292",
    "@xterm/addon-webgl": "0.20.0-beta.291",
    "@xterm/xterm": "6.1.0-beta.292",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.34.0",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tiptap-markdown": "~0.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.pi.desktop",
    "productName": "pi-workbench",
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/@vscode/ripgrep-*/**"
    ],
    "npmRebuild": false,
    "npmArgs": [],
    "extraResources": [
      {
        "from": "src/main/assets/tray-icon.png",
        "to": "assets/tray-icon.png",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/main/assets/tray-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/main/assets/tray-icon.ico",
      "uninstallerIcon": "src/main/assets/tray-icon.ico",
      "runAfterFinish": true
    },
    "mac": {
      "target": "dmg",
      "icon": "src/main/assets/tray-icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/main/assets/tray-icon.png",
      "category": "Development"
    },
    "directories": {
      "output": "release"
    }
  }
}